{
  "note": "Declaration lint only. The 44 local rule names are retained; Markdown headings, emphasis and exact native example wording are not behavioral evidence.",
  "rules": [
    {
      "id": "R01",
      "name": "levels A/B/C table",
      "pattern": "(?:Level\\s+A|\\|\\s*A\\s*\\|).*?(?:Level\\s+B|\\|\\s*B\\s*\\|).*?(?:Level\\s+C|\\|\\s*C\\s*\\|)"
    },
    {
      "id": "R02",
      "name": "Level B must not claim tone validation",
      "pattern": "未验证旋律"
    },
    {
      "id": "R03",
